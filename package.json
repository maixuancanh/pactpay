{
  "name": "pactpay",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc -b && vite build",
    "build:release": "node scripts/release.cjs",
    "test:contracts": "hardhat test",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "compile": "hardhat compile",
    "chain": "hardhat node --hostname 127.0.0.1 --port 8545",
    "deploy:local": "hardhat run scripts/deploy.cjs --network localhost",
    "smoke:local": "hardhat run scripts/smoke.cjs --network localhost",
    "probe:v3": "node scripts/probe-v3.cjs",
    "probe:native": "node --experimental-transform-types scripts/native-probe.mjs",
    "test:native:browser": "node scripts/native-browser.cjs",
    "test:native:multi": "node scripts/native-browser-multi.cjs",
    "test:release": "node --test scripts/release.test.cjs",
    "deploy:v3": "hardhat run scripts/deploy.cjs --network portaldot",
    "smoke:v3": "node scripts/v3-preflight.cjs",
    "evidence:verify": "node scripts/verify-evidence.cjs",
    "artifacts:browser": "hardhat compile && node scripts/export-artifacts.cjs",
    "test:native:portability": "node scripts/native-portability-browser.cjs",
    "test:native:accessibility": "node scripts/native-accessibility-browser.cjs",
    "test:native:checkout": "node scripts/native-checkout-browser.cjs",
    "dev:server": "npm --prefix server run dev:local",
    "test:server": "npm --prefix server test",
    "build:server": "npm --prefix server run build",
    "test:group:browser": "node scripts/group-commerce-browser.cjs",
    "probe:google:v3": "node scripts/probe-google-wallet-v3.cjs"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.0.2",
    "@polkadot/api": "17.0.2",
    "@polkadot/extension-dapp": "0.64.1",
    "@polkadot/util": "14.0.3",
    "@polkadot/util-crypto": "14.0.3",
    "@privy-io/react-auth": "3.51.0",
    "@radix-ui/react-alert-dialog": "1.1.15",
    "@radix-ui/react-dialog": "1.1.15",
    "@stripe/stripe-js": "1.54.2",
    "lucide-react": "0.468.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "viem": "2.57.14"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "2.1.0",
    "@nomicfoundation/hardhat-ethers": "3.1.0",
    "@playwright/test": "1.56.1",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "4.7.0",
    "chai": "4.5.0",
    "ethers": "6.15.0",
    "ganache": "7.9.2",
    "hardhat": "2.28.0",
    "prettier": "3.6.2",
    "prettier-plugin-solidity": "1.4.3",
    "solc": "0.8.24",
    "typescript": "5.9.3",
    "vite": "6.3.6",
    "vitest": "3.2.4"
  },
  "overrides": {
    "ws": "8.21.0",
    "cipher-base": "1.0.7",
    "pbkdf2": "3.1.7",
    "sha.js": "2.4.12",
    "webpack": "5.112.2"
  }
}
